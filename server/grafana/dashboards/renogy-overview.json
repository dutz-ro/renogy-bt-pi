      },
      "targets": [
        {
          "query": "from(bucket: \"telemetry\") |> range(start: -24h) |> filter(fn: (r) => r._measurement == \"renogy\" and r._field == \"battery_soc_pct\") |> last()",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "renogy-influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
